# Ensure Unix line endings for shell scripts and text files
*.sh text eol=lf
*.bash text eol=lf
*.md text eol=lf
*.py text eol=lf
*.R text eol=lf
*.rmd text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf

# Binary files
*.gz binary
*.bam binary
*.bai binary
*.fastq.gz binary
*.fa binary
*.fai binary
